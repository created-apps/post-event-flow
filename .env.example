# ─────────────────────────────────────────────────────────────────────────────
# Post-Event Lead Flow — environment configuration
# Copy this file to `.env` and fill in the placeholder values.
# Every value marked <...> is a placeholder you must replace.
# ─────────────────────────────────────────────────────────────────────────────

# --- Server ---------------------------------------------------------------
PORT=3000
# Public base URL of THIS backend (used in logs / Apps Script config).
PUBLIC_BASE_URL=https://<your-backend-host>

# Shared secret that Apps Script must send in the `x-ingest-token` header when
# posting new form rows to /leads. Generate a long random string.
INGEST_TOKEN=<random-long-secret>

# --- Supabase (database) --------------------------------------------------
# Project URL, e.g. https://abcd1234.supabase.co  (Settings → API → Project URL)
SUPABASE_URL=https://<your-project-ref>.supabase.co
# SERVICE ROLE key — server-side only, bypasses RLS. Never expose to a client.
# (Settings → API → Project API keys → service_role)
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
# If these two are left as placeholders the app uses an in-memory store so you
# can still run `node scripts/test-send.js` offline.

# --- Slack ----------------------------------------------------------------
# Bot User OAuth Token (starts with xoxb-). Needs scopes:
#   chat:write, channels:history (or groups:history for private channels).
SLACK_BOT_TOKEN=xoxb-<your-slack-bot-token>
# Only messages in this channel ID trigger a form rename. Leave blank to allow any.
SLACK_FORM_REQUEST_CHANNEL=<C0XXXXXXX>

# Polling mode — read new messages with conversations.history instead of
# receiving Event Subscriptions. No public URL / tunnel needed, so this is the
# way to test locally. (`npm run slack:poll` turns it on without this flag.)
SLACK_POLL_ENABLED=false
# Channel ID to poll. Defaults to SLACK_FORM_REQUEST_CHANNEL when blank.
SLACK_POLL_CHANNEL=
# How often to check for new messages (run as a node-cron job). Use a divisor
# of 60 for an even cadence; 60 and above are rounded to whole minutes.
SLACK_POLL_INTERVAL_SECONDS=5
# On a first run, how far back to look. 0 = only messages posted from now on.
SLACK_POLL_BACKFILL_SECONDS=0

# --- Google (Forms API) ---------------------------------------------------
# The single Google Form whose title we rename. This is the form ID from the
# edit URL: https://docs.google.com/forms/d/<FORM_ID>/edit
GOOGLE_FORM_ID=<your-form-id>
# Service account with access to the form. Supply the key EITHER way:
#   • Hosted (Render/Railway/etc.): base64 the whole JSON key and paste it here.
#       macOS/Linux:  base64 -i google-service-account.json | tr -d '\n'
#   • Local dev: point to the JSON file path instead (leave the base64 blank).
# The form MUST be shared (Editor) with this service account's client_email.
GOOGLE_CREDENTIALS_BASE64=<base64-of-service-account-json>
GOOGLE_APPLICATION_CREDENTIALS=./secrets/google-service-account.json
# Prefix applied to the form title, e.g. "CreatED — DAIS Lead Intake".
FORM_TITLE_PREFIX=CreatED —
FORM_TITLE_SUFFIX= Lead Intake

# --- Gemini (event-name extraction) --------------------------------------
# Google AI Studio API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash

# --- Twilio (WhatsApp) ----------------------------------------------------
TWILIO_ACCOUNT_SID=AC<your-account-sid>
TWILIO_AUTH_TOKEN=<your-auth-token>
# WhatsApp sender in E.164 with the whatsapp: prefix.
# Sandbox default: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Approved WhatsApp Content template SIDs (business-initiated messages require these).
# Submit the template bodies in docs/SETUP.md for approval, then paste the SIDs here.
TWILIO_CONTENT_SID_WA1=HX<whatsapp-1-template-sid>
TWILIO_CONTENT_SID_WA2=HX<whatsapp-2-template-sid>

# --- SendGrid (email) -----------------------------------------------------
SENDGRID_API_KEY=SG.<your-sendgrid-api-key>
# Verified sender identity.
EMAIL_FROM=team@create-ed.in
EMAIL_FROM_NAME=CreatED Team
# Optional BCC for internal record keeping.
EMAIL_BCC=

# --- Content / CTA --------------------------------------------------------
CONSULTATION_URL=https://www.create-ed.in/schedule-a-consultation
PROJECT_BROCHURE_LINK=https://www.create-ed.in
WEBSITE_URL=https://www.create-ed.in

# --- Sequence timing (override for testing) -------------------------------
# Delays in hours from lead capture. Defaults match the doc (Day 2 / Day 5).
DELAY_HOURS_DAY2=48
DELAY_HOURS_DAY5=120
# Testing shortcut: minutes, and they override the hours above when set.
# e.g. DELAY_MINUTES_DAY2=2 / DELAY_MINUTES_DAY5=5 to watch the whole sequence
# run in five minutes. Leave blank/absent to use the hours. The scheduler ticks
# once a minute, so anything under ~1 minute lands on the next tick anyway.
DELAY_MINUTES_DAY2=
DELAY_MINUTES_DAY5=
